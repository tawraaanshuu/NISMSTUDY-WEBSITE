# Copy to tools/secrets.env, fill in, then: chmod 600 tools/secrets.env
#
# tools/secrets.env is git-ignored and its values are never printed by
# deploy.sh. Do not paste these into chat, a commit, or config.js.

# Supabase personal access token.
# https://supabase.com/dashboard/account/tokens -> Generate new token
# Deploys the functions, sets their secrets and runs the SQL. Revoke it
# afterwards if you would rather it not linger.
SUPABASE_ACCESS_TOKEN=sbp_...

# Razorpay API keys.
# Razorpay Dashboard -> Account & Settings -> API Keys -> Generate.
# The secret is shown exactly once; regenerate if you lose it.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# A string you invent. Type the SAME value into Razorpay when you create the
# webhook. It is what proves an incoming webhook really came from Razorpay.
# Something like: openssl rand -hex 24
RAZORPAY_WEBHOOK_SECRET=...
